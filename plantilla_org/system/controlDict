FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

solver          incompressibleVoF;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         @@T_FINAL@@;
deltaT          1e-4;

writeControl    adjustableRunTime;
writeInterval   @@T_ESCRITURA@@;
purgeWrite      0;
writeFormat     ascii;
writePrecision  7;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable yes;

adjustTimeStep  yes;
maxCo           0.5;
maxAlphaCo      0.5;
maxDeltaT       0.01;

// El caudal de entrada se verifica en postproceso.py (balance de masa)
